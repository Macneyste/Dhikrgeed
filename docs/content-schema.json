{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Macneyste/Dhikrgeed/docs/content-schema.json",
  "title": "Dhikrgeed content pack",
  "description": "One file per pack in src/content/packs/<id>.json. Content rules (review status, sources) are checked by npm run validate:content.",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "id", "version", "title", "adhkar", "collections"],
  "properties": {
    "format": { "const": "dhikrgeed-pack" },
    "id": { "$ref": "#/$defs/id", "description": "Must match the file name." },
    "version": { "type": "integer", "minimum": 1, "description": "Bump when text or targets change." },
    "title": { "type": "string", "minLength": 1 },
    "adhkar": { "type": "array", "items": { "$ref": "#/$defs/dhikr" } },
    "collections": { "type": "array", "items": { "$ref": "#/$defs/collection" } }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9:-]{1,64}$" },
    "dhikr": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "arabic", "transliteration", "meaning", "source", "reviewStatus"],
      "properties": {
        "id": { "$ref": "#/$defs/id", "description": "Permanent. Never rename or reuse." },
        "label": { "type": "string", "minLength": 1 },
        "arabic": { "type": "string", "minLength": 1 },
        "transliteration": { "type": "string", "minLength": 1 },
        "meaning": { "type": "string", "description": "Somali meaning." },
        "source": { "type": "string", "description": "Reference, e.g. a hadith collection and number." },
        "reviewStatus": { "enum": ["draft", "reviewed"] }
      }
    },
    "collection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "subtitle", "items"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "title": { "type": "string", "minLength": 1 },
        "subtitle": { "type": "string" },
        "items": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["itemId", "dhikrId", "target", "phase"],
            "properties": {
              "itemId": { "$ref": "#/$defs/id" },
              "dhikrId": { "$ref": "#/$defs/id" },
              "target": { "type": "integer", "minimum": 1, "maximum": 9999 },
              "phase": { "enum": ["teal", "purple", "gold"] }
            }
          }
        }
      }
    }
  }
}
