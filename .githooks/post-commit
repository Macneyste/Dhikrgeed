#!/bin/sh
# Pushes every commit to GitHub right away.
# Skip once with: DHIKRGEED_NO_PUSH=1 git commit ...

[ "$DHIKRGEED_NO_PUSH" = "1" ] && exit 0

branch=$(git symbolic-ref --short -q HEAD) || exit 0  # detached HEAD: nothing to push

# Not during a rebase, merge or cherry-pick.
gitdir=$(git rev-parse --git-dir)
[ -d "$gitdir/rebase-merge" ] || [ -d "$gitdir/rebase-apply" ] && exit 0

if git rev-parse --abbrev-ref --symbolic-full-name '@{u}' >/dev/null 2>&1; then
  git push --quiet origin "$branch"
else
  git push --quiet --set-upstream origin "$branch"
fi || echo "post-commit: push failed (offline?). Run 'git push' later." >&2

exit 0
